# Variables del frontend. Vite las lee al COMPILAR, no al ejecutar: cambiar una
# en Cloudflare Pages exige volver a desplegar.

# Dirección del backend. En desarrollo con Docker: http://localhost:3000
VITE_API_URL=http://localhost:3000

# `false` oculta el enlace «Crear cuenta». El backend es quien cierra el registro
# de verdad (ALLOW_REGISTER); esto solo evita mostrar un enlace que no funciona.
# VITE_ALLOW_REGISTER=false
