# Variables del frontend. Vite las lee al COMPILAR, no al ejecutar: cambiar una
# en Cloudflare Pages exige volver a desplegar.

# Dirección del backend. En desarrollo con Docker: http://localhost:3000
VITE_API_URL=http://localhost:3000

# `false` oculta el botón «Crear cuenta» del login. Sin definir se muestra. El
# backend es quien cierra el registro de verdad (ALLOW_REGISTER); esto solo evita
# mostrar un botón que no funciona. Deben ir de acuerdo.
# VITE_ALLOW_REGISTER=false
