PORT=3000
DATABASE_URL=postgresql://tatuajes_user:tatuajes_pass@localhost:5432/tatuajes_db
JWT_SECRET=cambia_este_secreto_en_produccion

# --- Despliegue en la nube (ver docs/despliegue.md) --------------------------
# Con NODE_ENV=production el backend se niega a arrancar si JWT_SECRET falta, es
# el de ejemplo o tiene menos de 32 caracteres, y el registro queda cerrado.
# NODE_ENV=production

# Quién puede llamar a la API desde un navegador (uno o varios, separados por
# comas, sin barra final). Sin definir: en desarrollo cualquiera, en producción
# nadie.
# CORS_ORIGIN=https://tu-app.pages.dev

# Crear cuentas nuevas. Por defecto abierto en desarrollo y cerrado en producción.
# ALLOW_REGISTER=false

# Base en la nube: exige TLS si la cadena no trae ?sslmode=require.
# DATABASE_SSL=true
# Conexiones máximas del pool (por defecto 5, pensado para el plan gratis de Neon).
# DATABASE_POOL_MAX=5

# Proxies delante del servidor (para ver la IP real). Por defecto 1 en producción.
# TRUST_PROXY=1

# Recuperación de contraseña (HU03)
# Sin SMTP configurado el backend usa Ethereal y muestra la URL en consola.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Tattoo Platform <tucorreo@gmail.com>"

# Galería de bocetos (T0010): dónde se guardan las imágenes.
#   local      → carpeta uploads/ del backend (desarrollo, es el valor por defecto)
#   cloudinary → nube; requiere las tres credenciales de abajo
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=5242880
# URL pública del backend: prefija las imágenes servidas por el driver local.
PUBLIC_URL=http://localhost:3000

# Solo con STORAGE_DRIVER=cloudinary (panel de Cloudinary → Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tatuajes/sketches

# Usuario de prueba sembrado por `npm run db:init`
SEED_NAME="Nombre Apellido"
SEED_EMAIL=usuario@ejemplo.cl
SEED_PASSWORD=cambia-esta-clave

# --- Avisos y recordatorios (ver docs/whatsapp-y-notificaciones.md) -----------
# Notificaciones push (gratis). Se generan una vez con:  npm run vapid:generate
# La pública puede ir en cualquier parte; la privada es un secreto.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contacto que exige el estándar (mailto: o https:). Si falta, se usa FRONTEND_URL.
# VAPID_SUBJECT=mailto:tu@correo.cl

# Clave con la que un programador externo llama a POST /api/jobs/reminders. Sin
# ella ese endpoint no existe. Cualquier texto largo y aleatorio sirve.
# CRON_SECRET=

# Cada cuántos minutos revisa el propio servidor si toca algún recordatorio. 0 lo
# apaga (si solo lo dispara el programador externo). Por defecto 10.
# REMINDER_INTERVAL_MINUTES=10

# WhatsApp Business (API oficial de Meta). OPCIONAL y de pago por mensaje: sin
# estas dos variables los recordatorios no se mandan solos, sino que se le deja
# al artista un aviso con un enlace para enviarlos él (gratis).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_LANG=es
# Nombres de las plantillas aprobadas en Meta (estos son los por defecto):
# WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_cita
# WHATSAPP_TEMPLATE_CANCELACION=cita_cancelada
# WHATSAPP_TEMPLATE_REAGENDAMIENTO=cita_reagendada
# WHATSAPP_TEMPLATE_CUIDADOS=cuidados_tatuaje

# WhatsApp VINCULADO (gratis, NO oficial). Cada artista enlaza su propio WhatsApp como
# un «dispositivo vinculado» y los mensajes a sus clientes salen desde su número, sin
# costo por mensaje. Va contra los términos de WhatsApp y puede bloquear el número, así
# que está APAGADO salvo que se pida. Necesita la librería @whiskeysockets/baileys.
# Las credenciales de la sesión se guardan cifradas en la base con esta clave:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia, las sesiones ya vinculadas dejan de servir y hay que vincular de nuevo.
# WHATSAPP_WEB_ENABLED=true
# WHATSAPP_AUTH_KEY=
# Tope de mensajes por hora y por artista (por defecto 15). Más bajo = menos riesgo.
# WHATSAPP_WEB_MAX_PER_HOUR=15
# Conexiones abiertas a la vez en el servidor (por defecto 3; cada una pesa memoria).
# WHATSAPP_WEB_MAX_SESSIONS=3
# Minutos sin enviar antes de cerrar la conexión de un artista (por defecto 5).
# WHATSAPP_WEB_IDLE_MINUTES=5
