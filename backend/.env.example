PORT=3000
DATABASE_URL=postgresql://tatuajes_user:tatuajes_pass@localhost:5432/tatuajes_db
JWT_SECRET=cambia_este_secreto_en_produccion

# --- Despliegue en la nube (ver docs/despliegue.md) --------------------------
# Con NODE_ENV=production el backend se niega a arrancar si JWT_SECRET falta, es
# el de ejemplo o tiene menos de 32 caracteres, y el registro queda cerrado.
# NODE_ENV=production

# Quién puede llamar a la API desde un navegador (uno o varios, separados por
# comas, sin barra final). Sin definir: en desarrollo cualquiera, en producción
# nadie.
# CORS_ORIGIN=https://tu-app.pages.dev

# Crear cuentas nuevas. Por defecto abierto en desarrollo y cerrado en producción.
# ALLOW_REGISTER=false

# Base en la nube: exige TLS si la cadena no trae ?sslmode=require.
# DATABASE_SSL=true
# Conexiones máximas del pool (por defecto 5, pensado para el plan gratis de Neon).
# DATABASE_POOL_MAX=5

# Proxies delante del servidor (para ver la IP real). Por defecto 1 en producción.
# TRUST_PROXY=1

# Recuperación de contraseña (HU03)
# Sin SMTP configurado el backend usa Ethereal y muestra la URL en consola.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Tattoo Platform <tucorreo@gmail.com>"

# Galería de bocetos (T0010): dónde se guardan las imágenes.
#   local      → carpeta uploads/ del backend (desarrollo, es el valor por defecto)
#   cloudinary → nube; requiere las tres credenciales de abajo
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=5242880
# URL pública del backend: prefija las imágenes servidas por el driver local.
PUBLIC_URL=http://localhost:3000

# Solo con STORAGE_DRIVER=cloudinary (panel de Cloudinary → Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tatuajes/sketches

# Usuario de prueba sembrado por `npm run db:init`
SEED_NAME="Nombre Apellido"
SEED_EMAIL=usuario@ejemplo.cl
SEED_PASSWORD=cambia-esta-clave
